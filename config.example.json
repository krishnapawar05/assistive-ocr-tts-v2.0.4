{
  "camera": {
    "source_type": "opencv",
    "camera_id": 0,
    "resolution": "720p",
    "resolutions": {
      "720p": [
        1280,
        720
      ],
      "1080p": [
        1920,
        1080
      ]
    },
    "gstreamer_framerate": 30,
    "buffer_size": 1,
    "reconnect_initial_delay_s": 1.0,
    "reconnect_max_delay_s": 10.0,
    "max_consecutive_read_failures": 30,
    "read_failure_sleep_s": 0.01
  },
  "frame": {
    "preprocess": {
      "crop_if_larger_than": 1920,
      "crop_margin_fraction": 0.1,
      "upscale_min_side": 400,
      "min_side": 10,
      "max_input_side": 0
    },
    "quality": {
      "enabled": true,
      "min_width": 64,
      "min_height": 64,
      "min_contrast_std": 3.0,
      "dark_mean_max": 15.0,
      "bright_mean_min": 250.0,
      "bright_std_max": 6.0,
      "min_sharpness": 0.0
    },
    "change_detection": {
      "enabled": true,
      "thumbnail_size": 32,
      "min_mean_abs_diff": 2.0,
      "max_skip_s": 10.0
    }
  },
  "ocr": {
    "engine": "easyocr",
    "mode": "fallback",
    "fallback_order": [
      "easyocr",
      "paddle",
      "tesseract",
      "trocr"
    ],
    "language": "en",
    "text_type": "printed",
    "capture_interval": 0.2,
    "min_confidence": 0.5,
    "min_text_len": 3,
    "accept_score": 0.75,
    "min_final_score": 0.5,
    "serialize_engines": true,
    "preload": "primary",
    "engines": {
      "tesseract": {
        "enabled": true,
        "executable": "",
        "search_paths": [
          "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
          "C:\\Program Files (x86)\\Tesseract-OCR\\tesseract.exe",
          "/usr/bin/tesseract"
        ],
        "oem": 3,
        "psm": 6,
        "timeout_s": 20.0
      },
      "easyocr": {
        "enabled": true,
        "model_dir": "",
        "gpu": false,
        "include_english": true,
        "canvas_size": 2560,
        "mag_ratio": 1.0,
        "timeout_s": 60.0
      },
      "paddle": {
        "enabled": true,
        "model_root": "~/.paddlex/official_models",
        "det_model": "PP-OCRv5_server_det",
        "rec_models": {
          "en": "en_PP-OCRv5_mobile_rec",
          "hi": "devanagari_PP-OCRv5_mobile_rec",
          "kn": "ka_PP-OCRv3_mobile_rec"
        },
        "device": "cpu",
        "det_limit_side_len": 0,
        "det_limit_type": "max",
        "timeout_s": 60.0
      },
      "trocr": {
        "enabled": true,
        "model": "microsoft/trocr-base-handwritten",
        "max_new_tokens": 64,
        "line_min_confidence": 0.6,
        "timeout_s": 60.0
      }
    },
    "regions": {
      "min_contrast_std": 3.0,
      "min_gradient": 30.0,
      "join_width_fraction": 0.02,
      "join_height_px": 3,
      "min_line_height_px": 8,
      "max_line_height_fraction": 0.5,
      "min_aspect_ratio": 0.8,
      "merge_gap_height_ratio": 1.2,
      "merge_min_vertical_overlap": 0.5,
      "min_height_vs_median": 0.5,
      "max_regions": 12,
      "padding_px": 6
    },
    "scoring": {
      "weights": {
        "confidence": 0.35,
        "reliability": 0.2,
        "agreement": 0.15,
        "validity": 0.15,
        "language": 0.1,
        "length": 0.05,
        "bbox_agreement": 0.0,
        "speed": 0.0
      },
      "penalties": {
        "garbage": 0.5,
        "repetition": 0.3
      },
      "engine_reliability": {
        "printed": {
          "tesseract": 0.8,
          "easyocr": 0.85,
          "paddle": 0.9,
          "trocr": 0.4
        },
        "handwritten": {
          "tesseract": 0.3,
          "easyocr": 0.6,
          "paddle": 0.6,
          "trocr": 0.85
        }
      },
      "max_expected_len": 400,
      "latency_budget_s": 10.0
    },
    "duplicates": {
      "cooldown_s": 20.0,
      "fuzzy_threshold": 90.0,
      "refresh_on_repeat": true,
      "max_entries": 50
    }
  },
  "text": {
    "unicode_form": "NFC",
    "allowed_punctuation": ".,;:!?'\"()-/&%+@#$₹°",
    "edge_strip_chars": "|~`^_*\\<>{}[]=",
    "max_symbol_run": 1,
    "min_validity": 0.6
  },
  "tts": {
    "engine": "coqui",
    "fallback_engines": [
      "windows",
      "espeak"
    ],
    "language": "en",
    "coqui_model": "tts_models/en/vctk/vits",
    "voice": "p335",
    "speed": 1.0,
    "volume": 0.9,
    "max_chars": 300,
    "engines": {
      "coqui": {
        "enabled": true,
        "model_dir": "",
        "gpu": false
      },
      "windows": {
        "enabled": true,
        "voice": "",
        "rate_per_speed_unit": 5,
        "timeout_s": 60.0
      },
      "espeak": {
        "enabled": true,
        "executable": "",
        "search_paths": [
          "C:\\Program Files\\eSpeak NG\\espeak-ng.exe",
          "/usr/bin/espeak-ng"
        ],
        "voice": "",
        "base_wpm": 150,
        "min_wpm": 80,
        "max_wpm": 450,
        "max_amplitude": 200,
        "timeout_s": 60.0
      }
    }
  },
  "audio": {
    "policy": "queue",
    "max_queue_size": 5,
    "max_age_s": 30.0,
    "shutdown_timeout_s": 3.0
  },
  "pipeline": {
    "frame_wait_timeout_s": 0.3,
    "join_timeout_s": 3.0
  },
  "app": {
    "high_contrast": false,
    "font_size": "16px",
    "max_history": 50,
    "log_level": "INFO",
    "offline_mode": true
  }
}